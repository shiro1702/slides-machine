# Sprint 0–2 env — never commit real values
# cp .env.example .env.local

# Neon Postgres
DATABASE_URL=

# Vercel Blob
BLOB_READ_WRITE_TOKEN=

# Telegram BotFather
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Optional: public app URL for webhook setup + worker kick
# NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# Job worker auth (Vercel Cron sends Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=
# JOB_WORKER_SECRET=

# Sprint 1 — LLM (Groq). Without key, LLM_MODE defaults to fixture.
GROQ_API_KEY=
# LLM_MODE=fixture|groq
# GROQ_MODEL=llama-3.3-70b-versatile

# Sprint 2 — PNG render backend: remotion (default) | layout (no Chromium)
# RENDER_BACKEND=layout
# RENDER_SKIP_CHROMIUM=1
